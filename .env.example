# Register an OAuth 2.0 application at https://www.openstreetmap.org/oauth2/applications
# For local development, use the loopback hostname because OSM permits plain
# HTTP callbacks only for loopback development URLs:
# http://127.0.0.1:5173/api/osm/callback
OSM_CLIENT_ID=replace-with-your-osm-oauth-client-id
OSM_REDIRECT_URI=http://127.0.0.1:5173/api/osm/callback
